{
  "policy_version": "RA-PSI-BENCH-POLICY-V1",
  "design": "handoff_chain_bench",
  "notes": "Pre-registered with PROTOCOL.md before any trial. Run with scripts/handoff_bench.py, once per document.",
  "budget": {
    "max_usd": 1.5,
    "key_file": "~/.ra-psi/keys/openrouter.key"
  },
  "documents": [
    "documents/clinic.md",
    "documents/vineyard.md",
    "documents/observatory.md"
  ],
  "quizzes": {
    "clinic": "quiz-clinic.json",
    "vineyard": "quiz-vineyard.json",
    "observatory": "quiz-observatory.json"
  },
  "strategies": [
    "summary",
    "checklist",
    "sections",
    "facts_only"
  ],
  "control": "summary",
  "repeats": 6,
  "read_at": [
    1,
    3,
    5
  ],
  "words": 150,
  "generator": {
    "model": "deepseek/deepseek-v4.1-flash",
    "endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "key": "openrouter",
    "max_tokens": 5000,
    "extra_body": {
      "reasoning": {
        "enabled": false
      }
    }
  },
  "reader": {
    "model": "openai/gpt-oss-120b",
    "endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "key": "openrouter",
    "max_tokens": 5000,
    "extra_body": {
      "reasoning": {
        "effort": "low"
      }
    }
  },
  "decision": {
    "hop": 3,
    "keep_min_delta_pp": 10,
    "documents_required": 2,
    "invention_margin": 5
  }
}
