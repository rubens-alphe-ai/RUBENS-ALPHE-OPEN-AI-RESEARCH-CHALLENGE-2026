{
  "policy_version": "RA-PSI-BENCH-POLICY-V1",
  "design": "anchored_chain",
  "notes": "Pre-registered with PROTOCOL.md before any trial. Tests the coverage-inversion protocol proposed by the agent `zhaoxuan` on Moltbook in reply to MEM-011: model the note's coverage before seeing the index, mark every entry covered/uncertain/absent, spend the fetches on gaps first. Run with scripts/anchored_chain.py, once per document.",
  "budget": {
    "max_usd": 1.2,
    "key_file": "~/.ra-psi/keys/openrouter.key"
  },
  "documents": [
    "../PROP-EXP-MEM-008/documents/clinic.md",
    "../PROP-EXP-MEM-008/documents/vineyard.md",
    "../PROP-EXP-MEM-008/documents/observatory.md"
  ],
  "quizzes": {
    "clinic": "../PROP-EXP-MEM-008/quiz-clinic.json",
    "vineyard": "../PROP-EXP-MEM-008/quiz-vineyard.json",
    "observatory": "../PROP-EXP-MEM-008/quiz-observatory.json"
  },
  "ledgers": {
    "clinic": "../PROP-EXP-MEM-010/ledgers/ledger-clinic.json",
    "vineyard": "../PROP-EXP-MEM-010/ledgers/ledger-vineyard.json",
    "observatory": "../PROP-EXP-MEM-010/ledgers/ledger-observatory.json"
  },
  "regimes": [
    "bare",
    "anchored",
    "coverage"
  ],
  "control": "bare",
  "instruction": "summary",
  "repeats": 6,
  "read_at": [
    1,
    3,
    5
  ],
  "words": 150,
  "fetch": 4,
  "generator": {
    "model": "deepseek/deepseek-v4.1-flash",
    "endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "key": "openrouter",
    "max_tokens": 900,
    "extra_body": {
      "reasoning": {
        "enabled": false
      }
    }
  },
  "reader": {
    "model": "openai/gpt-oss-120b",
    "endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "key": "openrouter",
    "max_tokens": 2000,
    "extra_body": {
      "reasoning": {
        "effort": "low"
      }
    }
  },
  "decision": {
    "hop": 5,
    "keep_min_delta_pp": 20,
    "documents_required": 2,
    "gap_targeting_ratio": 2.0,
    "pays_for_itself_pp": 5,
    "invention_margin": 5
  },
  "credit": {
    "protocol_proposed_by": "zhaoxuan (Moltbook agent)",
    "source": "https://www.moltbook.com/post/fc9553ae-070e-488d-be78-cb8f7014618c"
  }
}
