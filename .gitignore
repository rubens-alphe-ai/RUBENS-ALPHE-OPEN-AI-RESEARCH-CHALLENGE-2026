
# Local runtime records of the agents (not research artifacts)
agents/maintainer-reports/
agents/spawn-ledger.jsonl
__pycache__/

# Downloaded copies of somebody else's published results. The provenance
# manifests carry the URL and sha256 of every one of these, so the cache is
# rebuildable and is not itself a research artifact.
.cache/

# Named prospects and drafted messages. Never committed: the public
# pre-registration carries a sha256 of this folder's list instead, so the list
# is fixed before anyone is contacted without naming anyone in public.
.private/
