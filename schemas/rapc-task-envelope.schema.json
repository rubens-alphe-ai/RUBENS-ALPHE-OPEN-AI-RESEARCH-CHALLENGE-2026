{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ra-psi.example/schemas/rapc-task-envelope.schema.json",
  "title": "RA-PSI RAPC Qwen task envelope",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "source_message_id",
    "source_thread_id",
    "created_at_utc",
    "mission",
    "mission_sha256",
    "envelope_sha256"
  ],
  "properties": {
    "schema_version": { "const": "RAPC-TASK-V1" },
    "task_id": { "type": "string", "pattern": "^rapc-[0-9a-f]{32}$" },
    "source_message_id": { "type": "string", "minLength": 1 },
    "source_thread_id": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "received_at_utc": { "type": "string" },
    "subject": { "type": "string" },
    "sender": { "type": "string" },
    "marker": { "const": "RAPC QVEN" },
    "mission": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "task": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "mission_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "envelope_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["READY", "PROCESSING", "DONE", "ERROR"] }
  },
  "additionalProperties": true
}
