{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RA-PSI structured memory V2 proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified_knowledge",
    "decisions",
    "failures",
    "experiments",
    "open_questions",
    "next_actions",
    "confidence_map",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "2.0-proposal" },
    "verified_knowledge": { "$ref": "#/$defs/claims" },
    "decisions": { "$ref": "#/$defs/claims" },
    "failures": { "$ref": "#/$defs/claims" },
    "experiments": { "$ref": "#/$defs/claims" },
    "open_questions": { "$ref": "#/$defs/claims" },
    "next_actions": { "$ref": "#/$defs/claims" },
    "confidence_map": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "provisional", "rejected", "open"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "source_type", "source_ref", "observed_at", "confidence", "status"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string" },
        "source_type": { "enum": ["email", "repo", "experiment", "paper", "human", "system"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["verified", "provisional", "rejected"] },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
